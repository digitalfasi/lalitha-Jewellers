ENVIRONMENT=development
DEBUG=false
# Local default is SQLite so the app runs with no setup. For Postgres:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dfx_wholesale
DATABASE_URL=sqlite+aiosqlite:///./wholesale_dev.db
# Used by Alembic only; falls back to DATABASE_URL when empty.
DIRECT_URL=
# At least 32 random characters. Changing it signs everyone out.
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# Photos and the business logo
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Email for sending bills (leave SMTP_HOST empty to switch email off)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
