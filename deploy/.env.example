# Copy to deploy/.env on the server (never commit .env). Generate the secrets with:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> .env
#   echo "SECRET_KEY=$(openssl rand -hex 32)" >> .env
POSTGRES_PASSWORD=
SECRET_KEY=

# Ports on 127.0.0.1 that the host's nginx forwards to. Check they're free first:
#   ss -ltn | grep -E ':(8020|3020)\b'   (no output = free)
API_PORT=8020
WEB_PORT=3020

# Optional: email bills (leave SMTP_HOST empty to keep email off)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
